---
import Layout from '../layouts/Layout.astro';
import Directory from '../components/Directory.svelte';
import ToolHeading from '../components/ToolHeading.astro';
---

<Layout
  title="All 24 time tools"
  description="Find timers, work-hour calculators, date tools, time-zone converters, and specialist time estimates."
  path="/tools/"
>
  <ToolHeading
    title="All time tools"
    description="24 tools for timing, calculations, work, dates, time zones, and rates."
  />
  <Directory client:load />
</Layout>
