---
import Layout from '../layouts/Layout.astro';
import Timer from '../components/Timer.svelte';
import ToolHeading from '../components/ToolHeading.astro';
import AdSlot from '../components/AdSlot.astro';
import { getTool, toolPath } from '../lib/tools';
const tool = getTool('timer');
---

<Layout
  title="Online timer & time calculators"
  description={tool.description}
  path="/"
  family={tool.family}
  app
>
  <ToolHeading
    title="Online timer"
    description="Set a duration, or count down to a clock time in any time zone."
    family={tool.family}
  />
  <div class="tool-layout">
    <div class="tool-main">
      <Timer client:load />
      <AdSlot placement="result" />
    </div>
    <AdSlot placement="side" />
  </div>
  <section class="tool-content">
    <h2>How to use the timer</h2>
    <p>{tool.intro}</p>
    <div class="worked-example">
      <h3>Try it</h3>
      <p>{tool.example}</p>
    </div>
    <h2>Timing and alarms</h2>
    <p>{tool.convention}</p>
    <p>
      Share link saves your settings or exact deadline. Opening a shared link
      lets you edit it before starting.
    </p>
  </section>
  <AdSlot placement="content" />
  <section class="related">
    <div class="section-heading">
      <h2>Other timing tools</h2>
      <a class="text-link" href="/tools/">
        All 24 tools →
      </a>
    </div>
    <div class="tool-grid">
      {tool.related.map((id) => {
        const item = getTool(id);
        return (
          <article class="tool-tile">
            <div>
              <h3>
                <a href={toolPath(id)}>
                  {item.name}
                  <span aria-hidden="true">→</span>
                </a>
              </h3>
              <p>{item.description}</p>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Layout>
