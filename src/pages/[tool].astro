---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.svelte';
import Timer from '../components/Timer.svelte';
import Timing from '../components/Timing.svelte';
import AdSlot from '../components/AdSlot.astro';
import ToolHeading from '../components/ToolHeading.astro';
import { familyStyle, getFamily } from '../lib/families';
import { tools, getTool, toolPath } from '../lib/tools';
export function getStaticPaths() {
  return tools
    .filter((t) => t.id !== 'timer')
    .map((tool) => ({ params: { tool: tool.id }, props: { tool } }));
}
const { tool } = Astro.props;
---

<Layout
  title={tool.name}
  description={tool.description}
  path={toolPath(tool.id)}
  app
  family={tool.family}
>
  <ToolHeading
    title={tool.name}
    description={tool.description}
    family={tool.family}
  />
  <div class="tool-layout">
    <div class="tool-main">
      {tool.id === 'countdown' ? (
        <Timer client:load event />
      ) : tool.id === 'stopwatch' ? (
        <Timing client:load />
      ) : tool.id === 'interval-timer' ? (
        <Timing client:load intervals />
      ) : (
        <Calculator client:load tool={tool} />
      )}
      <AdSlot placement="result" />
    </div>
    <AdSlot placement="side" />
  </div>
  <section class="tool-content">
    <h2>How to use {tool.name.toLowerCase()}</h2>
    <p>{tool.intro}</p>
    <div class="worked-example">
      <p class="eyebrow">Worked example</p>
      <p>{tool.example}</p>
    </div>
    <h2>What the result means</h2>
    <p>{tool.convention}</p>
    <p>
      {tool.id === 'countdown'
        ? 'Copy the address bar to share this countdown. A shared link opens immediately at the same finishing time, with sound off until enabled.'
        : 'Use Copy result to copy the displayed answer. Share link preserves the inputs so someone else can open and edit the calculation. This link does not start timing or request permissions.'}
    </p>
    <p>
      <a href="/conventions/">Read the calculation conventions →</a>
    </p>
  </section>
  <AdSlot placement="content" />
  <section class="related">
    <div class="section-heading">
      <h2>Related tools</h2>
      <a class="text-link" href="/tools/">
        All tools ↗
      </a>
    </div>
    <div class="tool-grid">
      {tool.related.map((id) => {
        const t = getTool(id);
        return (
          <article class="tool-tile family-scope" style={familyStyle(t.family)}>
            <div>
              <span class="family-label">
                <span class="family-mark" aria-hidden="true"></span>
                {getFamily(t.family).name}
              </span>
              <h3>
                <a href={toolPath(id)}>
                  {t.name}
                  <span aria-hidden="true">→</span>
                </a>
              </h3>
              <p>{t.description}</p>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Layout>
